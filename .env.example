# ── LLM Configuration ─────────────────────────────────────────────────────────
# Option A: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Option B: Google Gemini (via OpenAI-compatible endpoint)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash

# Option C: Ollama (local, no API key needed)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=llama3.2

# ── Scanner Configuration ──────────────────────────────────────────────────────
# Path to scan (Linux: /home, /; Windows demo: C:/Users)
SCAN_PATH=/home
# Enable demo mode (uses synthetic dataset instead of real filesystem)
DEMO_MODE=true
# Max depth for filesystem scan
MAX_SCAN_DEPTH=10

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=./diskmind.db

# ── Backend Server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Frontend URL (for CORS) ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
